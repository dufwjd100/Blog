function extractClaudeText_(json) {
  const content = json && Array.isArray(json.content) ? json.content : [];
  return content
    .map(block => {
      if (!block) return '';
      if (block.type === 'text') return String(block.text || '');
      return '';
    })
    .join('\n')
    .trim();
}

